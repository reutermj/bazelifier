check_c_source_compiles(
    name = "mhd_have_c_alignof",
    define = "HAVE_C_ALIGNOF",
    source = "#include <stdalign.h>\nint main(void) {\n  int var1[(alignof(int) >= 2) ? 1 : -1];\n  int var2[alignof(unsigned int) - 1];\n  int var3[(alignof(char) > 0) ? 1 : -1];\n  int var4[(alignof(long) >= 4) ? 1 : -1];\n  var1[0] = var2[0] = var3[0] = 0;\n  var4[0] = 1;\n  return var1[0] + var2[0] + var3[0] == var4[0];\n}\n",
)

check_c_source_compiles(
    name = "mhd_have___builtin_bswap32",
    define = "MHD_HAVE___BUILTIN_BSWAP32",
    link = True,
    source = "#include <stdint.h>\nint main(void) {\n  uint32_t a = 1; uint32_t b = __builtin_bswap32(a); a = b; (void) a;\n  return 0;\n}\n",
)

check_c_source_compiles(
    name = "mhd_have___builtin_bswap64",
    define = "MHD_HAVE___BUILTIN_BSWAP64",
    link = True,
    source = "#include <stdint.h>\nint main(void) {\n  uint64_t a = 1; uint64_t b = __builtin_bswap64(a); a = b; (void) a;\n  return 0;\n}\n",
)

