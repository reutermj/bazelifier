.TH "MPI_SESSION_INIT" "3" "Sep 16, 2026" "" "Open MPI"
.sp
\fI\%MPI_Session_init\fP — Creates a new session handle
.SH SYNTAX
.SS C Syntax
.INDENT 0.0
.INDENT 3.5
.sp
.EX
#include <mpi.h>

int MPI_Session_init(MPI_Info info, MPI_Errhandler errhandler, MPI_Session *session)
.EE
.UNINDENT
.UNINDENT
