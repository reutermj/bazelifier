    if test "$mpiext_cuda_WRAPPER_EXTRA_CPPFLAGS" != ""
then :


oac_var_scope_push ${LINENO} oac_list_prefix oac_list_append oac_list_arg oac_list_val

for oac_list_arg in $mpiext_cuda_WRAPPER_EXTRA_CPPFLAGS; do
    oac_list_append=1
