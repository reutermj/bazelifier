    elif test "$ompi_cv_fortran_external_symbol" = "no underscore" ; then
        ompi_ac_size_fn=size
    elif test "$ompi_cv_fortran_external_symbol" = "upper case" ; then
        ompi_ac_size_fn=SIZE
    else
