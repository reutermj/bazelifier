else $as_nop

    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking if MCA component rcache:gpusm can compile" >&5
printf %s "checking if MCA component rcache:gpusm can compile... " >&6; }
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
printf "%s\n" "no" >&6; }

