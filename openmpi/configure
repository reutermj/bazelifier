             done ;; #(
  *) :
     ;;
esac
    if test ${oac_list_append} -eq 1
then :

if test -z "${ompi_mca_wrapper_extra_cppflags}"
then :
  ompi_mca_wrapper_extra_cppflags="$oac_list_arg"
