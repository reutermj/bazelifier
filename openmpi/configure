    if test ${oac_list_append} -eq 1
then :

if test -z "${mca_wrapper_extra_cppflags}"
then :
  mca_wrapper_extra_cppflags="$oac_list_arg"
else $as_nop
  mca_wrapper_extra_cppflags="${mca_wrapper_extra_cppflags} $oac_list_arg"
