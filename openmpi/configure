                ;;
            *)  # maybe tar is smart?
                (cd "$expansion_dir" ; umask 0022 ; tar xf "$expansion_tarball" || as_fn_error $? "failed to extract 3rd-party/hwloc-2.7.1.tar.gz" "$LINENO" 5)
                ;;
