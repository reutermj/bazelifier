                                 MCA_ompi_FRAMEWORK_COMPONENT_STATIC_SUBDIRS="$MCA_ompi_FRAMEWORK_COMPONENT_STATIC_SUBDIRS \$(MCA_ompi_sharedfp_STATIC_SUBDIRS)"
