    if test "x$ompi_cv_fortran_have_iso_c_binding" = xyes
then :
  OMPI_FORTRAN_HAVE_ISO_C_BINDING=1
else $as_nop
  OMPI_FORTRAN_HAVE_ISO_C_BINDING=0
