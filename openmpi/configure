    case ${oac_list_arg} in #(
  -I*|-L*) :
    oac_list_append=1
             for oac_list_val in ${mca_wrapper_extra_libs} ; do
                 if test "x${oac_list_val}" = "x${oac_list_arg}"
then :
  oac_list_append=0
fi
             done
             if test ${oac_list_append} -eq 1
then :

if test -z "${mca_wrapper_extra_libs}"
then :
