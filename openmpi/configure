  BUILD_ompi_pml_v_DSO=1
else $as_nop
  BUILD_ompi_pml_v_DSO=0
fi
     if test "$BUILD_ompi_pml_v_DSO" = "1"; then
  MCA_BUILD_ompi_pml_v_DSO_TRUE=
  MCA_BUILD_ompi_pml_v_DSO_FALSE='#'
