fi
else $as_nop
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: ignoring rcache_gpusm_WRAPPER_EXTRA_CPPFLAGS ($rcache_gpusm_WRAPPER_EXTRA_CPPFLAGS): component conditions not met" >&5
