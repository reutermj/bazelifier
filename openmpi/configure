    oac_list_append=1
    case ${oac_list_arg} in #(
  -I*|-L*|-l*) :
    for oac_list_val in ${mca_wrapper_extra_cppflags}; do
                 if test "x${oal_list_val}" = "x${oac_list_arg}"
