                 if test "x${oal_list_val}" = "x${oac_list_arg}"
then :
  oac_list_append=0
fi
             done ;; #(
  *) :
     ;;
esac
    if test ${oac_list_append} -eq 1
then :

if test -z "${ompi_mca_wrapper_extra_ldflags}"
then :
