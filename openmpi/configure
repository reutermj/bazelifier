ac_compiler_gnu=$ac_cv_c_compiler_gnu


fi
{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $ompi_cv_fortran_max_array_rank" >&5
printf "%s\n" "$ompi_cv_fortran_max_array_rank" >&6; }

