   # There *must* be C bindings
           { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
printf "%s\n" "no" >&6; }
           { printf "%s\n" "$as_me:${as_lineno-$LINENO}: WARNING: C bindings for MPI extensions are required" >&5
