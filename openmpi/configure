    check_package_btl_smcuda_save_CPPFLAGS="${CPPFLAGS}"
    check_package_btl_smcuda_save_LDFLAGS="${LDFLAGS}"
    check_package_btl_smcuda_save_LIBS="${LIBS}"

    btl_smcuda_CPPFLAGS=
    btl_smcuda_LDFLAGS=
