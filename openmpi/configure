    if test "${check_package_pkgconfig_run_happy}" = "yes"
then :

else $as_nop
  { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: error" >&5
printf "%s\n" "error" >&6; }
                       as_fn_error $? "An error occurred retrieving ofi ldflags from pkg-config" "$LINENO" 5
fi

