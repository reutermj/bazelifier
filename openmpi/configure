{ printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: $ompi_check_ucx_cv_have_version_header" >&5
printf "%s\n" "$ompi_check_ucx_cv_have_version_header" >&6; }
           if test "${ompi_check_ucx_cv_have_version_header}" != "yes"
