            short*float*_Complex) ofc_type_kind=C_SHORT_FLOAT_COMPLEX ;;
            float*_Complex)       ofc_type_kind=C_FLOAT_COMPLEX       ;;
            double*_Complex)      ofc_type_kind=C_DOUBLE_COMPLEX      ;;
