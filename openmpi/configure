    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking if MPI Extension $component can compile" >&5
printf %s "checking if MPI Extension $component can compile... " >&6; }
    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes" >&5
printf "%s\n" "yes" >&6; }

