    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes" >&5
printf "%s\n" "yes" >&6; }

                        if test -f $infile; then
        # check for direct call header to include.  This will be
        # AC_SUBSTed later.
        if test "$DIRECT_pml" = "v" ; then
            if test "`$GREP DIRECT_CALL_HEADER $infile`" != "" ; then
