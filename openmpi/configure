# Some helper script functions.  Unfortunately, we cannot use  kinds
# of arguments here because of the m4 substitution.  So we have to set
# special variable names before invoking the function.  :-\

opal_show_title() {
  cat <<EOF

============================================================================
== ${1}
============================================================================
EOF
  if test -n "1"
then :
  printf "%s\n" "configure:5772: === ${1}" >&5
else $as_nop
  printf "%s\n" === ${1} >&5
fi
}


opal_show_subtitle() {
  cat <<EOF

*** ${1}
EOF
  if test -n "1"
then :
  printf "%s\n" "configure:5786: *** ${1}" >&5
else $as_nop
  printf "%s\n" *** ${1} >&5
fi
}


opal_show_subsubtitle() {
  cat <<EOF

+++ ${1}
EOF
  if test -n "1"
then :
  printf "%s\n" "configure:5800: +++ ${1}" >&5
else $as_nop
  printf "%s\n" +++ ${1} >&5
fi
}

opal_show_subsubsubtitle() {
  cat <<EOF

--- ${1}
EOF
  if test -n "1"
then :
  printf "%s\n" "configure:5813: --- ${1}" >&5
else $as_nop
  printf "%s\n" --- ${1} >&5
fi
}

opal_show_verbose() {
  if test "$V" = "1"; then
      cat <<EOF
+++ VERBOSE: ${1}
EOF
      if test -n "1"
then :
  printf "%s\n" "configure:5826: --- ${1}" >&5
else $as_nop
  printf "%s\n" --- ${1} >&5
fi
  fi
}

