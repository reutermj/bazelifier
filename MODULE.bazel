module(
    name = "bazelifier",
    version = "0.0.0",
)

# Hermetic C/C++ toolchain (LLVM-based). Backs the Rust toolchain below and
# builds the C/C++ output of converted CMake projects hermetically. See
# docs/architecture/build-verification.md.
bazel_dep(name = "llvm", version = "0.8.14")
bazel_dep(name = "rules_cc", version = "0.2.22")

# Autoconf-style toolchain probes for configure_file config headers. A local
# module for now (see docs/architecture/configure-file-and-toolchain-probes.md);
# converted modules will depend on it too. Built/tested here against the llvm
# toolchain registered below.
bazel_dep(name = "cc_config", version = "0.0.0")
local_path_override(
    module_name = "cc_config",
    path = "cc_config",
)

# Rust toolchain + crate_universe for the translator itself. See
# docs/architecture/overview.md for where this fits in the pipeline.
bazel_dep(name = "rules_rs", version = "0.0.98")
bazel_dep(name = "platforms", version = "1.1.0")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.92.0",
)
use_repo(toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//:all",
    "@llvm//toolchain:all",
)

# Third-party crates for the translator (translator/Cargo.toml). rules_rs
# only supports Cargo.lock-based resolution (no MODULE.bazel-only crate.spec
# form), so translator/Cargo.lock is a real, cargo-generated lockfile.
crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//translator:Cargo.lock",
    cargo_toml = "//translator:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
)
use_repo(crate, "crates")

# BUILD file linting/formatting. See docs/architecture/bazel-codegen.md.
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# Packages converted fixture modules into a validation tarball. See
# docs/architecture/build-verification.md.
bazel_dep(name = "tar.bzl", version = "0.10.7", dev_dependency = True)

# For sh_test targets that assert over the staged validation tree. The
# generated root module declares its own rules_shell dep independently — this
# one is ours, and only for tests that run inside this repo.
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# First real upstream CMake project driving new translator work (corpus),
# pinned to tinyxml2 11.0.0. This is INPUT to the translator only — its
# sources feed a convert_cmake_project target as `srcs`, and the translator
# copies the referenced ones into the standalone module it emits. The pinned
# commit is the version record; nothing here ends up in the generated
# output's own MODULE.bazel. See bzl-c54 and
# docs/architecture/build-verification.md.
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

# Fetched as a RELEASE TARBALL, not a git checkout, and that is the point: an
# autotools tarball ships `configure` pre-generated, while a checkout needs
# `autoreconf -i` first. Bootstrapping inside the conversion would make the
# result depend on the host's autoconf/automake versions rather than on the
# project — the same reason the CMake side does not vendor CMake.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

git_repository(
    name = "tinyxml2",
    # tinyxml2 ships no Bazel BUILD; expose the whole checkout as one
    # filegroup so convert_cmake_project can take the CMakeLists.txt +
    # sources as `srcs`. The translator (not Bazel) decides which files the
    # build actually references.
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "9148bdf719e997d1f474be6bcc7943881046dba1",  # tag 11.0.0
    remote = "https://github.com/leethomason/tinyxml2",
)

# Second corpus project: json-c 0.19, an autoconf-style C library whose
# configure_file-generated config headers (config.h/json_config.h/json.h)
# drive the next translator capability. INPUT to the translator only (same
# copy-through model as tinyxml2). See bzl-fxa.
git_repository(
    name = "json_c",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "25602128ed580416222601b4da5a50cdb1bc2a58",  # tag json-c-0.19-20260627
    remote = "https://github.com/json-c/json-c",
)

# Third corpus project: fmt 12.2.0, a C++ formatting library. Different in
# shape from the first two on purpose — 26 targets across three directories,
# 22 executables, and a VENDORED gtest as a real sub-library, where tinyxml2
# is one library plus one test and json-c is autoconf-style C.
#
# It needs NO new capability to reach a first conversion: no configure_file
# headers (only .pc/.cmake outputs, already filtered), no generated sources,
# all 21 CTest commands are build-tree binaries with test name == binary name.
# What it does bring is scale, C++, and non-source files listed as target
# sources (README.md/ChangeLog.md on the fmt library). INPUT to the translator
# only, same copy-through model as the others. See bzl-2wi.
git_repository(
    name = "fmt",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "1be298e1bd68957e4cd352e1f676f00e07dcfb57",  # tag 12.2.0
    remote = "https://github.com/fmtlib/fmt",
)

# Fourth corpus project: zlib 1.3.2. Brings the first SHARED_LIBRARY in the
# corpus — and unusually, builds the same sources both ways (libz.so as
# target `zlib`, libz.a as `zlibstatic`) with executables linking each, so a
# conversion either reproduces that split or is provably wrong. It also has a
# configure_file whose TEMPLATE is itself generated into the build directory
# (zconf.h.cmakein), and 10 CTest tests whose command is cmake/gcov rather
# than a built binary — the first real project to exercise that escalation.
# INPUT to the translator only, same copy-through model as the others.
# See bzl-i4i.
git_repository(
    name = "zlib",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    commit = "216c70c020aa53f0c40920d155f808b6b59c9acb",  # tag v1.3.2
    remote = "https://github.com/madler/zlib",
)

# First AUTOTOOLS corpus project: xz 5.4.7. Chosen over GNU hello, the
# canonical autotools project, after measuring both — hello is 170 lines of its
# own code around 72 vendored gnulib files, and gnulib GENERATES REPLACEMENT
# SYSTEM HEADERS (lib/stdio.h, lib/string.h, ...) that shadow the real ones.
# Converting it faithfully would mean building a gnulib-shaped feature no other
# project wants. See bzl-yjn.8.
#
# xz is the inverse: 105 of its own C files to 2 vendored, one generated
# header, and a target shape the frontend has never seen — a versioned shared
# library (liblzma.la), multiple programs, and 13 check_PROGRAMS. Its 172
# config macros are ~106 mechanical autoconf facts, which is catalog DATA work
# rather than new capability.
#
# INPUT to the translator only, same copy-through model as the CMake corpus.
http_archive(
    name = "xz",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-jbZmTEjKB5CLkrrtz+fzuiP0nvJHaGRRirXbZyODbnE=",
    strip_prefix = "xz-5.4.7",
    url = "https://github.com/tukaani-project/xz/releases/download/v5.4.7/xz-5.4.7.tar.gz",
)

# Second AUTOTOOLS corpus project: libexpat 2.6.2. Selected by measuring six
# candidates against the same test that rejected GNU hello above — gnulib's
# generated REPLACEMENT SYSTEM HEADERS, counted as `lib/*.in.h`:
#
#   expat 2.6.2    0 replacement headers, 13 own .c    <- chosen
#   gzip 1.13     26
#   patch 2.7.6   25
#   nano 7.2      38
#   libunistring  31
#   units 2.22     — no Makefile.am at all: a hand-written Makefile.in has no
#                    automake primaries for `make -p` to report, so the
#                    frontend's second source of truth would be empty
#
# What it adds over xz: recursive make across five SUBDIRS (lib, examples,
# tests, xmlwf, doc), where xz's tree is shallower, and a C++ check program
# beside the C ones. What makes it tractable where xz is not: 41 config
# macros against xz's 153, most already in the shared catalog — an escalation
# small enough to READ, which is the property that makes it useful for
# developing the onboarding procedure.
#
# Release TARBALL, not a git checkout, for the reason xz's entry gives: the
# tarball ships `configure` pre-generated, so the conversion does not depend
# on the host's autotools.
#
# INPUT to the translator only, same copy-through model as the rest.
http_archive(
    name = "expat",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-1M840m4hpWZU/+Ss2c1UgRZGGWJoAjKFBqKGmvqymrM=",
    strip_prefix = "expat-2.6.2",
    url = "https://github.com/libexpat/libexpat/releases/download/R_2_6_2/expat-2.6.2.tar.gz",
)

# Third AUTOTOOLS corpus project: jansson 2.14. Chosen to force the corpus's
# clearest gap rather than for a new target shape: xz and expat BOTH report
# `tests: 0`, so the Autotools frontend's test path has never been exercised
# end to end. That silence is bzl-b6m — `check_PROGRAMS` are not built by
# plain `make`, so they appear in no command and are dropped without an
# escalation. jansson is the first Autotools project in the corpus with a
# real compiled suite: 18 `check_PROGRAMS` under test/suites/api.
#
# Measured against the same criteria as expat:
#
#   jansson 2.14    0 gnulib headers, 14 own .c, 18 check_PROGRAMS  <- chosen
#   gsl 2.7.1       0 gnulib, but 1043 own .c — escalations nobody can read
#   libmicrohttpd   0 gnulib, 118 own .c — viable later, 8x larger
#   libidn2 2.3.7  19 gnulib replacement headers — the GNU hello rule
#   libffi 3.4.6    0 gnulib, but DejaGnu rather than automake TESTS, which
#                   would mean supporting a runner no other project uses
#   libuv v1.48.0   GitHub source archive with an incomplete m4/ — see
#                   bzl-mu5 on why that, not a missing `configure`, is the
#                   real disqualifier
#
# `make check` does not pass cleanly, and that is understood rather than
# overlooked: the api suite reports `F..................`, where the single
# failure is `check-exports` — a SCRIPT diffing exported symbols against a
# reference list — and all 18 compiled tests pass. Symbol versioning is
# already tracked as bzl-819, so jansson may exercise that too.
#
# INPUT to the translator only, same copy-through model as the rest.
http_archive(
    name = "jansson",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-V5jQEOQc+NdrZiNs+y8lQ8jQghgdFrwwhatJU41LmSk=",
    strip_prefix = "jansson-2.14",
    url = "https://github.com/akheron/jansson/releases/download/v2.14/jansson-2.14.tar.gz",
)

# Fourth AUTOTOOLS corpus project: libmicrohttpd 1.0.1. Onboarded to VALIDATE
# a capability rather than to add a shape — the automake `TESTS` classifier
# was built during jansson's onboarding, and jansson could only exercise its
# minority branch.
#
# The three shapes, measured across six projects before the classifier was
# written:
#
#   TESTS = $(check_PROGRAMS)   libmicrohttpd, gsl, wget   binaries, directly
#   a shell script              jansson, xz                drives them itself
#   a project-specific variable libgd, wget, gsl           nothing resolves it
#
# jansson is in the SECOND row. libmicrohttpd is the first, with `TESTS =
# $(check_PROGRAMS)` and 27 check_PROGRAMS declarations — so it tests the
# branch that covers most projects and that no corpus project has run.
#
# Rejected alternatives for that role: gsl has the same shape and 54 test
# declarations, but 1043 of its own .c files put its escalations well past
# what anyone can read; wget mixes all three shapes, which makes a failure
# hard to attribute.
#
# Larger than the other Autotools projects at 118 own .c files, and that is
# deliberate — jansson at 14 was chosen to make a bug obvious, this one to
# check the fix holds at scale. `make` and `make check TESTS=` both succeed
# natively, the latter building 161 test binaries.
#
# INPUT to the translator only, same copy-through model as the rest.
http_archive(
    name = "libmicrohttpd",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-qJ4J/JtN403eGfT8tPqqHOECmbmQjbETK7+h3keIK5Q=",
    strip_prefix = "libmicrohttpd-1.0.1",
    url = "https://ftp.gnu.org/gnu/libmicrohttpd/libmicrohttpd-1.0.1.tar.gz",
)

# gnulib PROOF PROJECT: libidn2 2.3.7. Not onboarded as a corpus project yet
# — pinned so the gnulib replacement-header path (bzl-9xo) has a real project
# to be tested against, since no existing corpus project vendors gnulib.
#
# Chosen over gzip, patch and nano, which vendor it too, because it is the
# small end: 11 generated replacement headers and 10 gnulib objects, against
# gzip's 18 and 55. Small to build the capability, large to validate it.
#
# NOTE it also carries AM_SILENT_RULES([yes]) — the macro that made a project
# convert to an empty graph until dbc8a52. It is the only project measured
# with it, which is why that bug survived four Autotools onboardings.
http_archive(
    name = "libidn2",
    build_file_content = """filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha256-TCGnkbYQuVGbnQ4SuAl78vNZsS+N2SZHYRqSnmv9fWQ=",
    strip_prefix = "libidn2-2.3.7",
    url = "https://ftp.gnu.org/gnu/libidn/libidn2-2.3.7.tar.gz",
)
