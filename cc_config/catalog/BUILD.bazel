assert_config_header_test(
    name = "catalog_smoke_test",
    header = ":catalog_smoke_h",
    must_contain = [
        "#define HAVE_ENDIAN_H",  # present on Linux
        "/* #undef HAVE_XLOCALE_H */",  # absent on glibc
        "#define HAVE_STDLIB_H",
        "#define SIZEOF_LONG 8",
        "#define SIZEOF_INT 4",
        "#define HAVE_SYS_SOCKET_H",
        "#define HAVE_NETINET_IN_H",
        "#define HAVE_ARPA_INET_H",
        "#define HAVE_NETDB_H",
        "#define HAVE_POLL_H",
        "#define HAVE_PTHREAD_H",
        "#define HAVE_SCHED_H",
        "#define HAVE_SIGNAL_H",
        "#define HAVE_TIME_H",
        "#define HAVE_ERRNO_H",
        "#define HAVE_STDDEF_H",
        "#define HAVE_STDALIGN_H",
        "#define HAVE_SYS_IOCTL_H",
        "#define HAVE_SYS_MMAN_H",
        "#define HAVE_SYS_SELECT_H",
        "#define HAVE_SYS_UIO_H",
        "#define HAVE_SYS_MSG_H",
        "#define HAVE_NET_IF_H",
        "#define HAVE_NETINET_IP_H",
        # Absent on this host BY DESIGN. A probe that answers `false`
        # here answers `true` on the platform the header belongs to,
        # which is why these are probed rather than left out. If one
        # of these starts reading `#define`, the path is wrong — a
        # typo also reports absent, indistinguishable from correct.
        "/* #undef HAVE_WINSOCK2_H */",  # absent here — Windows
        "/* #undef HAVE_SYS_ENDIAN_H */",  # absent here — BSD
        "/* #undef HAVE_SYS_ISA_DEFS_H */",  # absent here — Solaris
        "/* #undef HAVE_VXCPULIB_H */",  # absent here — VxWorks; camelCase is unrecoverable from the macro
        # PRESENT on glibc, and the most valuable assertion of this group:
        # it proves the harvested path is right. The reverse guess reads the
        # macro as `netinet/ip/icmp.h`, which does not exist — that probe
        # would report absent, and absent is indistinguishable from a correct
        # answer for a header this host genuinely lacks. Only a header that
        # IS here can catch a wrong path.
        "#define HAVE_NETINET_IP_ICMP_H",
        "#define HAVE_UTIME",  # present on glibc — this is the assertion that can catch a wrong header,
        # since a bad path reports absent just like a missing symbol
        "#define HAVE_FUTIMES",  # present on glibc
        "/* #undef HAVE_PLEDGE */",
        "#define HAVE_DECL_CPU_SETSIZE 1",  # declared on glibc — the assertion with teeth, since a wrong header
        # reports 0 exactly like a genuinely-absent declaration
        "#define HAVE_DECL_HW_NCPU 0",  # BSD only. DEFINED to 0, not undefined — autoconf's ternary contract  # OpenBSD only
        "#define HAVE_NETINET_TCP_H",
    ],
    must_not_contain = [
        "#define HAVE_XLOCALE_H",  # must not be defined on glibc
        "@SIZEOF_LONG@",  # substituted
    ],
)

# The catalog's own BUILD file, as data for the drift check that compares this
# list of defines against the translator's CATALOG_DEFINES copy. Exported
# rather than read from the source tree because the check runs as a Bazel test,
# where inputs are sandboxed. See //:catalog_sync_check.
exports_files(["BUILD.bazel"])
