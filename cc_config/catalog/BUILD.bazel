# Smoke test: consume catalog probes through a config header and assert the
# values are correct for the toolchain the module builds against (llvm +
# glibc, Linux x86-64). These facts are stable for that toolchain.
#
# It is the ONLY thing that checks a catalog entry's header PATH.
# //:catalog_sync_check compares the define NAMES here against the
# translator's CATALOG_DEFINES and cannot see the path at all, so a typo in
# one used to pass both gates while the probe silently reported false — and
# false is indistinguishable from "the platform lacks it". Mutating
# sys/socket.h to sys/sockettypo.h now fails this test; it did not before.
#
# So an entry added to the catalog above wants an assertion here. Not every
# one is worth the line, but a probe nothing asserts is a probe whose answer
# nothing has ever checked.
load("//cc_config:config_header.bzl", "assert_config_header_test", "config_header")
load(":catalog.bzl", "cc_config_catalog")

# The shared catalog of common autoconf facts. Seeded from what real projects
# (json-c) check; a project needing a fact not here adds one line. Each probe
# is public and referenced by converted modules' config_header targets, so a
# fact is probed once per toolchain across the whole graph (see
# ../sharing_test.sh). Target names are the define lowercased.
cc_config_catalog(
    # (header, HAVE_ macro) — check_include_file.
    headers = [
        ("bsd/stdlib.h", "HAVE_BSD_STDLIB_H"),
        ("byteswap.h", "HAVE_BYTESWAP_H"),
        ("cpuid.h", "HAVE_CPUID_H"),
        ("dlfcn.h", "HAVE_DLFCN_H"),
        ("endian.h", "HAVE_ENDIAN_H"),
        ("fcntl.h", "HAVE_FCNTL_H"),
        ("getopt.h", "HAVE_GETOPT_H"),
        ("immintrin.h", "HAVE_IMMINTRIN_H"),
        ("inttypes.h", "HAVE_INTTYPES_H"),
        ("limits.h", "HAVE_LIMITS_H"),
        ("locale.h", "HAVE_LOCALE_H"),
        ("memory.h", "HAVE_MEMORY_H"),
        ("stdarg.h", "HAVE_STDARG_H"),
        ("stdbool.h", "HAVE_STDBOOL_H"),
        ("stdio.h", "HAVE_STDIO_H"),
        ("stdint.h", "HAVE_STDINT_H"),
        ("stdlib.h", "HAVE_STDLIB_H"),
        ("string.h", "HAVE_STRING_H"),
        ("strings.h", "HAVE_STRINGS_H"),
        ("syslog.h", "HAVE_SYSLOG_H"),
        ("unistd.h", "HAVE_UNISTD_H"),
        ("wchar.h", "HAVE_WCHAR_H"),
        ("xlocale.h", "HAVE_XLOCALE_H"),
        ("arpa/inet.h", "HAVE_ARPA_INET_H"),
        ("errno.h", "HAVE_ERRNO_H"),
        ("net/if.h", "HAVE_NET_IF_H"),
        ("netdb.h", "HAVE_NETDB_H"),
        ("netinet/in.h", "HAVE_NETINET_IN_H"),
        ("netinet/ip.h", "HAVE_NETINET_IP_H"),
        ("netinet/tcp.h", "HAVE_NETINET_TCP_H"),
        ("poll.h", "HAVE_POLL_H"),
        ("pthread.h", "HAVE_PTHREAD_H"),
        ("sched.h", "HAVE_SCHED_H"),
        ("signal.h", "HAVE_SIGNAL_H"),
        ("stdalign.h", "HAVE_STDALIGN_H"),
        ("stddef.h", "HAVE_STDDEF_H"),
        ("time.h", "HAVE_TIME_H"),
        ("sys/ioctl.h", "HAVE_SYS_IOCTL_H"),
        ("sys/mman.h", "HAVE_SYS_MMAN_H"),
        ("sys/msg.h", "HAVE_SYS_MSG_H"),
        ("sys/select.h", "HAVE_SYS_SELECT_H"),
        ("sys/socket.h", "HAVE_SYS_SOCKET_H"),
        ("sys/uio.h", "HAVE_SYS_UIO_H"),
        ("sys/cdefs.h", "HAVE_SYS_CDEFS_H"),
        ("sys/param.h", "HAVE_SYS_PARAM_H"),
        ("sys/random.h", "HAVE_SYS_RANDOM_H"),
        ("sys/resource.h", "HAVE_SYS_RESOURCE_H"),
        ("sys/stat.h", "HAVE_SYS_STAT_H"),
        ("sys/time.h", "HAVE_SYS_TIME_H"),
        ("sys/types.h", "HAVE_SYS_TYPES_H"),
    ],
    # (symbol, [declaring headers], HAVE_ macro) — check_symbol_exists.
    symbols = [
        (
            "clock_gettime",
            ["time.h"],
            "HAVE_CLOCK_GETTIME",
        ),
        # autoconf's AC_HEADER_STDC, which every autoconf project emits. It
        # asks whether the C89 standard headers are present and conforming;
        # probing for `free` in stdlib.h is the practical form of that, and is
        # what the answer turns on for any toolchain this converts against.
        (
            "free",
            ["stdlib.h"],
            "STDC_HEADERS",
        ),
        (
            "futimens",
            ["sys/stat.h"],
            "HAVE_FUTIMENS",
        ),
        (
            "getopt_long",
            ["getopt.h"],
            "HAVE_GETOPT_LONG",
        ),
        (
            "mbrtowc",
            ["wchar.h"],
            "HAVE_MBRTOWC",
        ),
        (
            "open",
            ["fcntl.h"],
            "HAVE_OPEN",
        ),
        (
            "posix_fadvise",
            ["fcntl.h"],
            "HAVE_POSIX_FADVISE",
        ),
        (
            "realloc",
            ["stdlib.h"],
            "HAVE_REALLOC",
        ),
        (
            "strtoll",
            ["stdlib.h"],
            "HAVE_STRTOLL",
        ),
        (
            "strtoull",
            ["stdlib.h"],
            "HAVE_STRTOULL",
        ),
        (
            "setlocale",
            ["locale.h"],
            "HAVE_SETLOCALE",
        ),
        (
            "uselocale",
            ["locale.h"],
            "HAVE_USELOCALE",
        ),
        (
            "duplocale",
            ["locale.h"],
            "HAVE_DUPLOCALE",
        ),
        (
            "strdup",
            ["string.h"],
            "HAVE_STRDUP",
        ),
        (
            "strerror",
            ["string.h"],
            "HAVE_STRERROR",
        ),
        (
            "strcasecmp",
            ["strings.h"],
            "HAVE_STRCASECMP",
        ),
        (
            "strncasecmp",
            ["strings.h"],
            "HAVE_STRNCASECMP",
        ),
        (
            "snprintf",
            ["stdio.h"],
            "HAVE_SNPRINTF",
        ),
        (
            "vsnprintf",
            ["stdio.h"],
            "HAVE_VSNPRINTF",
        ),
        (
            "vasprintf",
            ["stdio.h"],
            "HAVE_VASPRINTF",
        ),
        (
            "vprintf",
            ["stdio.h"],
            "HAVE_VPRINTF",
        ),
        (
            "vsyslog",
            ["syslog.h"],
            "HAVE_VSYSLOG",
        ),
        (
            "getrandom",
            ["sys/random.h"],
            "HAVE_GETRANDOM",
        ),
        (
            "getrusage",
            ["sys/resource.h"],
            "HAVE_GETRUSAGE",
        ),
        (
            "setrlimit",
            ["sys/resource.h"],
            "HAVE_SETRLIMIT",
        ),
        (
            "arc4random",
            ["stdlib.h"],
            "HAVE_ARC4RANDOM",
        ),
    ],
    # (type, [declaring headers], SIZEOF_ macro) — check_type_size.
    types = [
        ("int", [], "SIZEOF_INT"),
        ("long", [], "SIZEOF_LONG"),
        ("long long", [], "SIZEOF_LONG_LONG"),
        (
            "size_t",
            ["stddef.h"],
            "SIZEOF_SIZE_T",
        ),
        (
            "ssize_t",
            ["sys/types.h"],
            "SIZEOF_SSIZE_T",
        ),
        (
            "int64_t",
            ["stdint.h"],
            "SIZEOF_INT64_T",
        ),
    ],
)

config_header(
    name = "catalog_smoke_h",
    output = "catalog_smoke.h",
    probes = [
        ":have_endian_h",
        ":have_xlocale_h",
        ":have_stdlib_h",
        ":sizeof_long",
        ":sizeof_int",
        ":have_sys_socket_h",
        ":have_netinet_in_h",
        ":have_arpa_inet_h",
        ":have_netdb_h",
        ":have_poll_h",
        ":have_pthread_h",
        ":have_sched_h",
        ":have_signal_h",
        ":have_time_h",
        ":have_errno_h",
        ":have_stddef_h",
        ":have_stdalign_h",
        ":have_sys_ioctl_h",
        ":have_sys_mman_h",
        ":have_sys_select_h",
        ":have_sys_uio_h",
        ":have_sys_msg_h",
        ":have_net_if_h",
        ":have_netinet_ip_h",
        ":have_netinet_tcp_h",
    ],
    template = "testdata_catalog_smoke.h.in",
)

assert_config_header_test(
    name = "catalog_smoke_test",
    header = ":catalog_smoke_h",
    must_contain = [
        "#define HAVE_ENDIAN_H",  # present on Linux
        "/* #undef HAVE_XLOCALE_H */",  # absent on glibc
        "#define HAVE_STDLIB_H",
        "#define SIZEOF_LONG 8",
        "#define SIZEOF_INT 4",
        "#define HAVE_SYS_SOCKET_H",
        "#define HAVE_NETINET_IN_H",
        "#define HAVE_ARPA_INET_H",
        "#define HAVE_NETDB_H",
        "#define HAVE_POLL_H",
        "#define HAVE_PTHREAD_H",
        "#define HAVE_SCHED_H",
        "#define HAVE_SIGNAL_H",
        "#define HAVE_TIME_H",
        "#define HAVE_ERRNO_H",
        "#define HAVE_STDDEF_H",
        "#define HAVE_STDALIGN_H",
        "#define HAVE_SYS_IOCTL_H",
        "#define HAVE_SYS_MMAN_H",
        "#define HAVE_SYS_SELECT_H",
        "#define HAVE_SYS_UIO_H",
        "#define HAVE_SYS_MSG_H",
        "#define HAVE_NET_IF_H",
        "#define HAVE_NETINET_IP_H",
        "#define HAVE_NETINET_TCP_H",
    ],
    must_not_contain = [
        "#define HAVE_XLOCALE_H",  # must not be defined on glibc
        "@SIZEOF_LONG@",  # substituted
    ],
)

# The catalog's own BUILD file, as data for the drift check that compares this
# list of defines against the translator's CATALOG_DEFINES copy. Exported
# rather than read from the source tree because the check runs as a Bazel test,
# where inputs are sandboxed. See //:catalog_sync_check.
exports_files(["BUILD.bazel"])
