    # (header, HAVE_ macro) — check_include_file.
    headers = [
        ("bsd/stdlib.h", "HAVE_BSD_STDLIB_H"),
        # Headers the corpus checks that this host does NOT have — BSD,
        # Solaris, Windows, VxWorks, macOS, and optional libraries. A probe
        # for an absent header compiles, fails, and records `false`, which is
        # the CORRECT answer for this platform and becomes `true` on one that
        # has it. That is the whole point of probing rather than baking: see
        # overview.md on replicating behaviour rather than this host's
        # outcome.
        #
        # Paths harvested from each project's own `configure`, never guessed
        # from the macro name. The forward direction is autoconf's own
        # transform (uppercase, non-alphanumerics to `_`) and is exact; the
        # reverse is ambiguous and would have gotten four of these wrong —
        # `netinet/ip_icmp.h` reads equally as `netinet/ip/icmp.h`, and
        # `inetLib.h`/`vxCpuLib.h`/`sys/_cpuset.h` are unrecoverable from
        # `HAVE_INETLIB_H` at all.
        ("CommonCrypto/CommonDigest.h", "HAVE_COMMONCRYPTO_COMMONDIGEST_H"),
        ("features.h", "HAVE_FEATURES_H"),
        ("gcrypt.h", "HAVE_GCRYPT_H"),
