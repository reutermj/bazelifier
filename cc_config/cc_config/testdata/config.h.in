/* Test template for config_header. */
#cmakedefine HAVE_STDLIB_H
#cmakedefine HAVE_NO_SUCH_SYMBOL
#cmakedefine PACKAGE_NAME "@PACKAGE_NAME@"
#define PACKAGE_VERSION "@PACKAGE_VERSION@"
#define SIZEOF_LONG @SIZEOF_LONG@

/* bzl-fxa.24: CMake expands a #cmakedefine wherever it appears on the line,
   not only at the start. json-c writes exactly this shape. Both forms below
   must expand, and the unset one drops the prefix the way CMake does. */
/* #cmakedefine HAVE_STDLIB_H @PACKAGE_NAME@*/
/* #cmakedefine HAVE_NO_SUCH_SYMBOL @PACKAGE_NAME@ */

/* autoconf's dialect: a bare #undef is the same statement CMake spells
   with its own directive, written as the false case. A project converted from autotools
   ships templates in this form (GNU hello's config.in has 227). */
#undef HAVE_STDLIB_H
/* A macro reached ONLY through autoconf's dialect. HAVE_NO_SUCH_SYMBOL used
   to serve here too, but it is also a #cmakedefine above, so its expansion
   satisfied the assertion whether or not this branch ran at all. */
#undef HAVE_DEFINITELY_NO_SUCH_HEADER_H
int not_a_directive; /* #undef LEAVE_ME_ALONE */
