load("@aspect_rules_py//py:defs.bzl", "py_binary")
load(":config_header.bzl", "assert_config_header_test", "config_header")
load(":probe.bzl", "assert_probe_result_test", "check_include_file", "check_symbol_exists", "check_type_size", "probe_alias")

exports_files([
    "probe.bzl",
    "config_header.bzl",
])

# The config-header expander, run by the config_header rule (config_header.bzl).
# aspect_rules_py's py_binary runs cleanly as an exec-config build tool.
py_binary(
    name = "expand_config_header",
    srcs = ["expand_config_header.py"],
    visibility = ["//visibility:public"],
)

# Probe-mechanics tests: a header that must exist under any C toolchain, and
# one that cannot. They exercise both outcomes of the compile probe — that a
# failed compile is captured as "false" rather than failing the build is the
# whole point. Run against whatever cc toolchain the building configuration
# resolves (llvm, when built from bazelifier).
check_include_file(
    name = "have_stdlib_h",
    define = "HAVE_STDLIB_H",
    header = "stdlib.h",
)

assert_probe_result_test(
    name = "stdlib_h_is_found",
    expected = True,
    probe = ":have_stdlib_h",
)

check_include_file(
    name = "have_definitely_no_such_header",
    define = "HAVE_DEFINITELY_NO_SUCH_HEADER_H",
    header = "definitely/no/such/header_xyz123.h",
)

assert_probe_result_test(
    name = "missing_header_is_not_found",
    expected = False,
    probe = ":have_definitely_no_such_header",
)

# Symbol probes: a libc function that must link, and one that cannot. The
# link step is what distinguishes these from a header probe — a declared but
# unresolvable symbol compiles yet fails to link.
check_symbol_exists(
    name = "have_printf",
    define = "HAVE_PRINTF",
    headers = ["stdio.h"],
    symbol = "printf",
)

assert_probe_result_test(
    name = "printf_is_found",
    expected = True,
    probe = ":have_printf",
)

check_symbol_exists(
    name = "have_no_such_symbol",
    define = "HAVE_NO_SUCH_SYMBOL",
    headers = ["stdio.h"],
    symbol = "definitely_no_such_symbol_xyz123",
)

assert_probe_result_test(
    name = "missing_symbol_is_not_found",
    expected = False,
    probe = ":have_no_such_symbol",
)

# bzl-fxa.7: a probe compiled under _GNU_SOURCE. glibc gates strdup (and
# vasprintf, uselocale, ...) behind _GNU_SOURCE, so a bare probe reports them
# absent on a strict toolchain, and the project's *_compat.h then defines a
# colliding fallback. This asserts the `defines` attr yields a valid TRUE.
#
# The both-DIRECTIONS proof (bare -> false, _GNU_SOURCE -> true) can't live
# here: cc_config's own tests run against the HOST cc (gcc), whose -std=gnu*
# default implies _GNU_SOURCE, so the bare probe is already true. The gating
# only manifests under the strict llvm/libc++ toolchain the CONVERTED modules
# build with — so the negative direction is a translator fixture
# (020-gnu-source-symbol), which builds under llvm in the unpacked workspace.
check_symbol_exists(
    name = "have_strdup_gnu",
    define = "HAVE_STRDUP",
    defines = ["_GNU_SOURCE"],
    headers = ["string.h"],
    symbol = "strdup",
)

assert_probe_result_test(
    name = "strdup_present_with_gnu_source",
    expected = True,
    probe = ":have_strdup_gnu",
)

# A size probe, exercised through the config header below: sizeof(long) is
# determined at compile time and substituted as a value.
check_type_size(
    name = "sizeof_long",
    define = "SIZEOF_LONG",
    type = "long",
)

# End-to-end: a template resolved from real probe results (HAVE_STDLIB_H true,
# HAVE_NO_SUCH_SYMBOL false, SIZEOF_LONG a number) plus @VAR@ values.
config_header(
    name = "test_config_h",
    output = "test_config.h",
    probes = [
        ":have_stdlib_h",
        ":have_no_such_symbol",
        ":have_definitely_no_such_header",
        ":sizeof_long",
    ],
    template = "testdata/config.h.in",
    values = {
        "PACKAGE_NAME": "cc_config_test",
        "PACKAGE_VERSION": "1.2.3",
    },
)

assert_config_header_test(
    name = "config_header_test",
    header = ":test_config_h",
    must_contain = [
        # A true probe becomes a #define; a false one becomes /* #undef */.
        "#define HAVE_STDLIB_H",
        "/* #undef HAVE_NO_SUCH_SYMBOL */",
        # @VAR@ substituted in a #cmakedefine value and a plain line.
        "#define PACKAGE_NAME \"cc_config_test\"",
        "#define PACKAGE_VERSION \"1.2.3\"",
        # A size probe's number substituted as a value (8 on the linux
        # x86-64 toolchain this builds against).
        "#define SIZEOF_LONG 8",
        # bzl-fxa.24: a directive that does not start the line still expands,
        # and the unset form drops whatever preceded it rather than nesting
        # comment openers. Both verified against CMake 3.28's own output.
        "/* #define HAVE_STDLIB_H cc_config_test*/",
        # autoconf's `#undef FOO` resolves the same way `#cmakedefine FOO`
        # does, so the same probe result produces the same header whichever
        # build system the project used. Both directions, and the false one
        # uses a macro NO #cmakedefine in this template mentions — otherwise
        # the other dialect satisfies the needle and disabling this branch
        # entirely leaves the test green.
        "#define HAVE_STDLIB_H 1",
        "/* #undef HAVE_DEFINITELY_NO_SUCH_HEADER_H */",
        # A mid-line #undef is ordinary C undefining a macro, not a directive
        # to rewrite; rewriting it would corrupt the header.
        "int not_a_directive; /* #undef LEAVE_ME_ALONE */",
    ],
    must_not_contain = [
        "#define HAVE_NO_SUCH_SYMBOL",
        "@PACKAGE_VERSION@",
        "@SIZEOF_LONG@",
        # The literal directive must not survive anywhere — that is exactly
        # what json-c's generated header retained (bzl-fxa.24).
        "#cmakedefine",
        # And the unset form must not nest comment openers.
        "/* /* #undef",
    ],
)

# fxa.6 regression: a boolean probe's result must populate its @VAR@, not just
# its #cmakedefine presence. json-c writes facts as `#cmakedefine FOO @FOO@` and
# evaluates them with `#if FOO`; before the fix a true boolean probe left the
# @FOO@ literal, so the #if saw `@FOO@` and the header failed to compile. These
# probes are named for the template's macros (the config_header rule keys
# results by the probe's `define`).
check_include_file(
    name = "json_c_have_stdlib",
    define = "JSON_C_HAVE_STDLIB",
    header = "stdlib.h",
)

check_symbol_exists(
    name = "json_c_have_absent",
    define = "JSON_C_HAVE_ABSENT",
    headers = ["stdio.h"],
    symbol = "definitely_no_such_symbol_xyz123",
)

config_header(
    name = "boolean_var_h",
    output = "boolean_var.h",
    probes = [
        ":json_c_have_stdlib",
        ":json_c_have_absent",
    ],
    template = "testdata/boolean_var.h.in",
)

assert_config_header_test(
    name = "boolean_var_test",
    header = ":boolean_var_h",
    must_contain = [
        # The true probe's @VAR@ resolves to 1 — both in the #cmakedefine value
        # and in the bare @VAR@ line. This is the fix: pre-fix these were the
        # literal `@JSON_C_HAVE_STDLIB@`, which a downstream `#if` can't parse.
        "#define JSON_C_HAVE_STDLIB 1",
        "#define STDLIB_FLAG 1",
        # The false probe still undefs (empty @VAR@ is not "set").
        "/* #undef JSON_C_HAVE_ABSENT */",
    ],
    must_not_contain = [
        # No literal @VAR@ survives for either the true or the false probe.
        "@JSON_C_HAVE_STDLIB@",
        "@JSON_C_HAVE_ABSENT@",
    ],
)

# fxa.8 regression: an option's value that is a CMake-false token must undef its
# #cmakedefine, not #define the literal token. json-c left ENABLE_RDRAND etc.
# OFF; before the fix bool("OFF") was True, so the macro became `#define
# ENABLE_RDRAND OFF` and code using it compiled the bare token. These options
# arrive as plain `values` (an option's cache value), never as probes.
config_header(
    name = "false_tokens_h",
    output = "false_tokens.h",
    template = "testdata/false_tokens.h.in",
    values = {
        "ENABLE_RDRAND": "OFF",
        "ENABLE_THREADING": "FALSE",
        "OVERRIDE_GET_RANDOM_SEED": "NO",
        "SOME_NOTFOUND": "SOME_NOTFOUND-NOTFOUND",
        "ENABLE_FEATURE": "0",
        "ENABLE_ON_FEATURE": "ON",
    },
)

assert_config_header_test(
    name = "false_tokens_test",
    header = ":false_tokens_h",
    must_contain = [
        # Every CMake-false token undefs — OFF, FALSE, NO, a *-NOTFOUND, 0.
        "/* #undef ENABLE_RDRAND */",
        "/* #undef ENABLE_THREADING */",
        "/* #undef OVERRIDE_GET_RANDOM_SEED */",
        "/* #undef SOME_NOTFOUND */",
        "/* #undef ENABLE_FEATURE */",
        # A truthy token still defines.
        "#define ENABLE_ON_FEATURE",
        # A bare @VAR@ keeps the literal token, matching CMake.
        "#define RDRAND_RAW OFF",
    ],
    must_not_contain = [
        # The false-token bug: the literal token defined instead of undef'd.
        "#define ENABLE_RDRAND OFF",
        "#define ENABLE_THREADING FALSE",
        "#define OVERRIDE_GET_RANDOM_SEED NO",
    ],
)

# probe_alias: a project stamps a catalog fact into a project-prefixed define
# (json-c's JSON_C_HAVE_INTTYPES_H, set from HAVE_INTTYPES_H). The alias must
# report the UNDERLYING probe's answer, so both directions are asserted — an
# alias hardwired to "1" would satisfy the present case on its own. Reuses the
# existing true/false probes above rather than declaring new ones, which also
# demonstrates the point of the rule: no second probe action is created.
probe_alias(
    name = "aliased_have_present",
    define = "ALIASED_HAVE_PRESENT",
    probe = ":have_stdlib_h",
)

probe_alias(
    name = "aliased_have_absent",
    define = "ALIASED_HAVE_ABSENT",
    probe = ":have_definitely_no_such_header",
)

config_header(
    name = "probe_alias_h",
    output = "probe_alias.h",
    probes = [
        ":aliased_have_present",
        ":aliased_have_absent",
    ],
    template = "testdata/probe_alias.h.in",
)

assert_config_header_test(
    name = "probe_alias_test",
    header = ":probe_alias_h",
    must_contain = [
        # The alias carries the true probe's answer under the NEW name, and
        # populates its @VAR@ (same contract as any boolean probe).
        "#define ALIASED_HAVE_PRESENT 1",
        # ... and the false probe's answer, rather than defaulting to present.
        "/* #undef ALIASED_HAVE_ABSENT */",
    ],
    must_not_contain = [
        # The failure this guards: an alias that reports its fact as found
        # regardless of what the underlying probe answered.
        "#define ALIASED_HAVE_ABSENT",
        # The macro the alias renames FROM must not leak into the output —
        # the alias republishes under the new name only.
        "HAVE_STDLIB_H",
        "@ALIASED_HAVE_PRESENT@",
        "@ALIASED_HAVE_ABSENT@",
    ],
)

# Two config headers that both consume the SAME probe target
# (:have_stdlib_h), standing in for two converted projects that each need
# HAVE_STDLIB_H. Because a probe is a shared TARGET, its compile action is
# analyzed once no matter how many config headers reference it — so the probe
# runs once per toolchain across the whole graph, not once per project. The
# sharing_test.sh script (run in review, see cc_config/README.md) proves this
# via `bazel aquery`, which can't be expressed as a Bazel test without a
# circular bazel-inside-bazel. These two targets are the fixture it inspects;
# building them both here at least confirms two consumers of one probe don't
# conflict.
config_header(
    name = "shared_consumer_a",
    output = "consumer_a.h",
    probes = [":have_stdlib_h"],
    template = "testdata/consumer.h.in",
)

config_header(
    name = "shared_consumer_b",
    output = "consumer_b.h",
    probes = [":have_stdlib_h"],
    template = "testdata/consumer.h.in",
)
