check_c_source_compiles(
    name = "pmix_have_attribute_noreturn",
    define = "PMIX_HAVE_ATTRIBUTE_NORETURN",
    source = "#include <unistd.h>\n#include <stdlib.h>\nvoid fatal(int arg1) __attribute__ ((__noreturn__));\nvoid fatal(int arg1) { exit(arg1); }\n",
