# ---- Agent-stage resolutions (bzl-7r9.5), each a decision with its reason.
#
# Probes the project runs with its OWN snippets — compiler attributes, C11
# keywords, builtins, a pthread constant — reproduced verbatim from PMIx's m4
# (config/pmix_check_attributes.m4, pmix_setup_cc.m4, pmix_config_pthreads.m4)
# so the consumer's compiler is asked the question configure asked. Two of
# them (__builtin_prefetch, __builtin_clz) put statements at file scope, which
# is why configure answers 0 for both on every compiler; kept as written.
# configure additionally greps the compiler's warnings for "ignored" on the
# attribute checks, which this probe cannot; on a compiler that only warns,
# an attribute answers 1 here where configure answered 0.
check_c_source_compiles(
    name = "pmix_have_attribute",
    define = "PMIX_HAVE_ATTRIBUTE",
    source = "#include <stdlib.h>\nint main(void) {\n  struct foo {\n      char a;\n      int x[2] __attribute__ ((__packed__));\n   };\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_aligned",
    define = "PMIX_HAVE_ATTRIBUTE_ALIGNED",
    source = "struct foo { char text[4]; }  __attribute__ ((__aligned__(8)));\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_always_inline",
    define = "PMIX_HAVE_ATTRIBUTE_ALWAYS_INLINE",
    source = "int foo (int arg) __attribute__ ((__always_inline__));\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_cold",
    define = "PMIX_HAVE_ATTRIBUTE_COLD",
    source = "int foo(int arg1, int arg2) __attribute__ ((__cold__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_const",
    define = "PMIX_HAVE_ATTRIBUTE_CONST",
    source = "int foo(int arg1, int arg2) __attribute__ ((__const__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_deprecated",
    define = "PMIX_HAVE_ATTRIBUTE_DEPRECATED",
    source = "int foo(int arg1, int arg2) __attribute__ ((__deprecated__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_deprecated_argument",
    define = "PMIX_HAVE_ATTRIBUTE_DEPRECATED_ARGUMENT",
    source = "int foo(int arg1, int arg2) __attribute__ ((__deprecated__(\"compiler allows argument\")));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_format",
    define = "PMIX_HAVE_ATTRIBUTE_FORMAT",
    source = "int this_printf (void *my_object, const char *my_format, ...) __attribute__ ((__format__ (__printf__, 2, 3)));\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_format_funcptr",
    define = "PMIX_HAVE_ATTRIBUTE_FORMAT_FUNCPTR",
    source = "int (*this_printf)(void *my_object, const char *my_format, ...) __attribute__ ((__format__ (__printf__, 2, 3)));\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_hot",
    define = "PMIX_HAVE_ATTRIBUTE_HOT",
    source = "int foo(int arg1, int arg2) __attribute__ ((__hot__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_malloc",
    define = "PMIX_HAVE_ATTRIBUTE_MALLOC",
    source = "#include <stdlib.h>\nint * foo(int arg1) __attribute__ ((__malloc__));\nint * foo(int arg1) { return (int*) malloc(arg1); }\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_may_alias",
    define = "PMIX_HAVE_ATTRIBUTE_MAY_ALIAS",
    source = "int * p_value __attribute__ ((__may_alias__));\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_no_instrument_function",
    define = "PMIX_HAVE_ATTRIBUTE_NO_INSTRUMENT_FUNCTION",
    source = "int * foo(int arg1) __attribute__ ((__no_instrument_function__));\n",
)
check_c_source_compiles(
    name = "pmix_have_attribute_nonnull",
    define = "PMIX_HAVE_ATTRIBUTE_NONNULL",
    source = "int square(int *arg) __attribute__ ((__nonnull__));\nint square(int *arg) { return *arg; }\n",
