# ---- Agent-stage resolutions (bzl-7r9.6), each a decision with its reason.
#
# Probes PRRTE runs with its OWN snippets — compiler attributes, C11
# keywords, builtins, pthread and ptrace constants — reproduced from its m4
# so the consumer's compiler is asked the question configure asked. As in
# PMIx: the m4 also greps warnings for "ignored", which a probe cannot, and
# __builtin_prefetch/__builtin_clz put statements at file scope (0 always).
check_c_source_compiles(
    name = "prte_have_attribute",
    define = "PRTE_HAVE_ATTRIBUTE",
    source = "#include <stdlib.h>\nint main(void) {\n  struct foo {\n      char a;\n      int x[2] __attribute__ ((__packed__));\n   };\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_aligned",
    define = "PRTE_HAVE_ATTRIBUTE_ALIGNED",
    source = "struct foo { char text[4]; }  __attribute__ ((__aligned__(8)));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_always_inline",
    define = "PRTE_HAVE_ATTRIBUTE_ALWAYS_INLINE",
    source = "int foo (int arg) __attribute__ ((__always_inline__));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_cold",
    define = "PRTE_HAVE_ATTRIBUTE_COLD",
    source = "int foo(int arg1, int arg2) __attribute__ ((__cold__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_const",
    define = "PRTE_HAVE_ATTRIBUTE_CONST",
    source = "int foo(int arg1, int arg2) __attribute__ ((__const__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_deprecated",
    define = "PRTE_HAVE_ATTRIBUTE_DEPRECATED",
    source = "int foo(int arg1, int arg2) __attribute__ ((__deprecated__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_deprecated_argument",
    define = "PRTE_HAVE_ATTRIBUTE_DEPRECATED_ARGUMENT",
    source = "int foo(int arg1, int arg2) __attribute__ ((__deprecated__(\"compiler allows argument\")));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_format",
    define = "PRTE_HAVE_ATTRIBUTE_FORMAT",
    source = "int this_printf (void *my_object, const char *my_format, ...) __attribute__ ((__format__ (__printf__, 2, 3)));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_format_funcptr",
    define = "PRTE_HAVE_ATTRIBUTE_FORMAT_FUNCPTR",
    source = "int (*this_printf)(void *my_object, const char *my_format, ...) __attribute__ ((__format__ (__printf__, 2, 3)));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_hot",
    define = "PRTE_HAVE_ATTRIBUTE_HOT",
    source = "int foo(int arg1, int arg2) __attribute__ ((__hot__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_malloc",
    define = "PRTE_HAVE_ATTRIBUTE_MALLOC",
    source = "#include <stdlib.h>\nint * foo(int arg1) __attribute__ ((__malloc__));\nint * foo(int arg1) { return (int*) malloc(arg1); }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_may_alias",
    define = "PRTE_HAVE_ATTRIBUTE_MAY_ALIAS",
    source = "int * p_value __attribute__ ((__may_alias__));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_no_instrument_function",
    define = "PRTE_HAVE_ATTRIBUTE_NO_INSTRUMENT_FUNCTION",
    source = "int * foo(int arg1) __attribute__ ((__no_instrument_function__));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_noinline",
    define = "PRTE_HAVE_ATTRIBUTE_NOINLINE",
    source = "int foo(int arg1, int arg2) __attribute__ ((__noinline__));\nint foo(int arg1, int arg2) { return arg1 * arg2 + arg1; }\nstatic int bar(int arg1, int arg2) __attribute__ ((__noinline__));\nstatic int bar(int arg1, int arg2) { return arg1 * arg2 + arg1; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_nonnull",
    define = "PRTE_HAVE_ATTRIBUTE_NONNULL",
    source = "int square(int *arg) __attribute__ ((__nonnull__));\nint square(int *arg) { return *arg; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_noreturn",
    define = "PRTE_HAVE_ATTRIBUTE_NORETURN",
    source = "#include <unistd.h>\n#include <stdlib.h>\nvoid fatal(int arg1) __attribute__ ((__noreturn__));\nvoid fatal(int arg1) { exit(arg1); }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_noreturn_funcptr",
    define = "PRTE_HAVE_ATTRIBUTE_NORETURN_FUNCPTR",
    source = "#include <unistd.h>\n#include <stdlib.h>\nextern void (*fatal_exit)(int arg1) __attribute__ ((__noreturn__));\nvoid fatal(int arg1) { fatal_exit (arg1); }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_packed",
    define = "PRTE_HAVE_ATTRIBUTE_PACKED",
    source = "struct foo {\n    char a;\n    int x[2] __attribute__ ((__packed__));\n};\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_pure",
    define = "PRTE_HAVE_ATTRIBUTE_PURE",
    source = "int square(int arg) __attribute__ ((__pure__));\nint square(int arg) { return arg * arg; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_sentinel",
    define = "PRTE_HAVE_ATTRIBUTE_SENTINEL",
    source = "int my_execlp(const char * file, const char *arg, ...) __attribute__ ((__sentinel__));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_unused",
    define = "PRTE_HAVE_ATTRIBUTE_UNUSED",
    source = "int square(int arg1 __attribute__ ((__unused__)), int arg2);\nint square(int arg1, int arg2) { return arg2; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_visibility",
    define = "PRTE_HAVE_ATTRIBUTE_VISIBILITY",
    source = "int square(int arg1) __attribute__ ((__visibility__(\"hidden\")));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_warn_unused_result",
    define = "PRTE_HAVE_ATTRIBUTE_WARN_UNUSED_RESULT",
    source = "int foo(int arg) __attribute__ ((__warn_unused_result__));\nint foo(int arg) { return arg + 3; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_weak_alias",
    define = "PRTE_HAVE_ATTRIBUTE_WEAK_ALIAS",
    source = "int foo(int arg);\nint foo(int arg) { return arg + 3; }\nint foo2(int arg) __attribute__ ((__weak__, __alias__(\"foo\")));\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_destructor",
    define = "PRTE_HAVE_ATTRIBUTE_DESTRUCTOR",
    source = "void foo(void) __attribute__ ((__destructor__));\nvoid foo(void) { return ; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_optnone",
    define = "PRTE_HAVE_ATTRIBUTE_OPTNONE",
    source = "void __attribute__ ((__optnone__)) foo(void);\nvoid foo(void) { return ; }\n",
)
check_c_source_compiles(
    name = "prte_have_attribute_extension",
    define = "PRTE_HAVE_ATTRIBUTE_EXTENSION",
    source = "int i = __extension__ 3;\n",
)
check_c_source_compiles(
    name = "prte_c_have___thread",
    define = "PRTE_C_HAVE___THREAD",
    source = "int main(void) {\nstatic __thread int  foo = 1;++foo;\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_c_have__thread_local",
    define = "PRTE_C_HAVE__THREAD_LOCAL",
    source = "int main(void) {\nstatic _Thread_local int  foo = 1;++foo;\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_c_have_atomic_conv_var",
    define = "PRTE_C_HAVE_ATOMIC_CONV_VAR",
    source = "#include <stdatomic.h>\nint main(void) {\nstatic atomic_long foo = 1;++foo;\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_c_have__atomic",
    define = "PRTE_C_HAVE__ATOMIC",
    source = "#include <stdatomic.h>\nint main(void) {\nstatic _Atomic long foo = 1;++foo;\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_have_clang_builtin_atomic_c11_func",
    define = "PRTE_HAVE_CLANG_BUILTIN_ATOMIC_C11_FUNC",
    source = "#include <stdatomic.h>\nint main(void) {\natomic_int acnt = 0; __c11_atomic_fetch_add(&acnt, 1, memory_order_relaxed);\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_c_have__generic",
    define = "PRTE_C_HAVE__GENERIC",
    source = "#define FOO(x) (_Generic (x, int: 1))\nint main(void) {\nstatic int x, y; y = FOO(x);\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_c_have__static_assert",
    define = "PRTE_C_HAVE__STATIC_ASSERT",
    source = "#include <stdint.h>\nint main(void) {\n_Static_assert(sizeof(int64_t) == 8, \"WTH\");\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_c_have_builtin_expect",
    define = "PRTE_C_HAVE_BUILTIN_EXPECT",
    source = "int main(void) {\nvoid *ptr = (void*) 0;\n           if (__builtin_expect (ptr != (void*) 0, 1)) return 0;\n  ;\n  return 0;\n}\n",
    link = True,
)
check_c_source_compiles(
    name = "prte_c_have_builtin_prefetch",
    define = "PRTE_C_HAVE_BUILTIN_PREFETCH",
    source = "int ptr;\n           __builtin_prefetch(&ptr,0,0);\nint main(void) {\n\n  ;\n  return 0;\n}\n",
    link = True,
)
check_c_source_compiles(
    name = "prte_c_have_builtin_clz",
    define = "PRTE_C_HAVE_BUILTIN_CLZ",
    source = "int value = 0xffff; /* we know we have 16 bits set */\n             if ((8*sizeof(int)-16) != __builtin_clz(value)) return 0;\nint main(void) {\n\n  ;\n  return 0;\n}\n",
    link = True,
)
check_c_source_compiles(
    name = "prte_have_pthread_mutex_errorcheck_np",
    define = "PRTE_HAVE_PTHREAD_MUTEX_ERRORCHECK_NP",
    source = "#include <pthread.h>\nint main(void) {\npthread_mutexattr_settype(NULL, PTHREAD_MUTEX_ERRORCHECK_NP);\n  ;\n  return 0;\n}\n",
    link = True,
    defines = ["_GNU_SOURCE"],
)
check_c_source_compiles(
    name = "prte_have_pthread_mutex_errorcheck",
    define = "PRTE_HAVE_PTHREAD_MUTEX_ERRORCHECK",
    source = "#include <pthread.h>\nint main(void) {\npthread_mutexattr_settype(NULL, PTHREAD_MUTEX_ERRORCHECK);\n  ;\n  return 0;\n}\n",
    link = True,
)
check_c_source_compiles(
    name = "words_bigendian",
    define = "WORDS_BIGENDIAN",
    source = "int probe[__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__ ? 1 : -1];\n",
)
check_c_source_compiles(
    name = "prte_have_linux_ptrace",
    define = "PRTE_HAVE_LINUX_PTRACE",
    source = "#pragma GCC diagnostic error \"-Wincompatible-pointer-types\"\n#include \"sys/ptrace.h\"\nint main(void) {\nlong (*ptr)(enum __ptrace_request request, pid_t pid, void *addr, void *data);\nptr = ptrace;\n  ;\n  return 0;\n}\n",
)
check_c_source_compiles(
    name = "prte_have_stop_on_exec",
    define = "PRTE_HAVE_STOP_ON_EXEC",
    source = "#include <sys/ptrace.h>\n#if !(defined(PTRACE_TRACEME) || defined(PT_TRACE_ME)) || !(defined(PTRACE_DETACH) || defined(PT_DETACH))\n#error no stop-on-exec\n#endif\n\nint main(void) {\n(void) ptrace;\n  ;\n  return 0;\n}\n",
    link = True,
)

