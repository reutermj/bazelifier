# Bazel output symlinks
/bazel-*

# Cargo build output. No Bazel build produces this — it only appears when
# someone runs `cargo` directly in translator/, which is a supported thing
# to do (see docs/runbooks/001-regenerate-translator-cargo-lock.md) and
# used to leave hundreds of untracked artifacts behind.
/translator/target/

# Bazel local user config
/.bazelrc.user

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# autoconf regenerates this from configure.ac; committing it makes a
# sandboxed build try to re-run aclocal against a read-only tree.
autom4te.cache/

# Python bytecode from running the sweep scripts directly.
__pycache__/
*.pyc
