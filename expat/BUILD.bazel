# The project also ships a checked-in `expat_config.h`. It is deliberately NOT in
# this module: the build reads the GENERATED one, and a source file at the
# same path wins the include search and would hide it, an unresolved
# macro's #error included. Resolve values on this rule; do not restore
# that file.
# configure.ac's `--with-sys-getrandom` check, default "check": a Linux
# syscall, so a probe rather than a value.
check_c_source_compiles(
    name = "expat_have_syscall_getrandom",
    define = "HAVE_SYSCALL_GETRANDOM",
    link = True,
    source = "#include <stdlib.h>\n#include <unistd.h>\n#include <sys/syscall.h>\nint main() {\n  syscall(SYS_getrandom, NULL, 0, 0);\n  return 0;\n}\n",
)

# AC_C_BIGENDIAN, asked of the compiler's own byte-order macro.
check_c_source_compiles(
    name = "expat_words_bigendian",
    define = "WORDS_BIGENDIAN",
    source = "int probe[__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__ ? 1 : -1];\n",
)

config_header(
    name = "expat_config_h",
    output = "expat_config.h",
    template = "expat_config.h.in",
    probes = [
        "@cc_config//catalog:have_arc4random",
        "@cc_config//catalog:have_arc4random_buf",
        "@cc_config//catalog:have_dlfcn_h",
        "@cc_config//catalog:have_fcntl_h",
        "@cc_config//catalog:have_getpagesize",
        "@cc_config//catalog:have_getrandom",
        "@cc_config//catalog:have_inttypes_h",
        "@cc_config//catalog:have_mmap",
        "@cc_config//catalog:have_stdint_h",
        "@cc_config//catalog:have_stdio_h",
        "@cc_config//catalog:have_stdlib_h",
        "@cc_config//catalog:have_string_h",
        "@cc_config//catalog:have_strings_h",
        "@cc_config//catalog:have_sys_param_h",
        "@cc_config//catalog:have_sys_stat_h",
        "@cc_config//catalog:have_sys_types_h",
        "@cc_config//catalog:have_unistd_h",
        "@cc_config//catalog:stdc_headers",
        ":expat_have_syscall_getrandom",
        ":expat_words_bigendian",
    ],
    values = select({
        ":enable_xml_attr_info_on": {"XML_ATTR_INFO": "1"},
        "//conditions:default": {},
    }) | select({
        ":enable_xml_context_on": {"XML_CONTEXT_BYTES": "1024"},
        "//conditions:default": {"XML_CONTEXT_BYTES": "0"},
    }) | {
        "AC_APPLE_UNIVERSAL_BUILD": "",  # no Apple universal build
        # configure sets BYTEORDER beside WORDS_BIGENDIAN from the same
        # AC_C_BIGENDIAN answer; the template wants the number, so it is the
        # compiler's byte order as an expression (xmltok.c only tests it in
        # #if), not this host's 1234.
        "BYTEORDER": "(__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__ ? 4321 : 1234)",
        "HAVE_CXX11": "1",  # --with-tests, the default the ground truth used
        "HAVE_LIBBSD": "",  # --with-libbsd defaults to no
        "LT_OBJDIR": "\".libs/\"",
        "PACKAGE_URL": "\"\"",
        # autoconf's fallback definitions, only for a toolchain lacking them
        "const": "",
        "off_t": "",
        "size_t": "",
        "PACKAGE": "\"expat\"",
        "PACKAGE_BUGREPORT": "\"https://github.com/libexpat/libexpat/issues\"",
        "PACKAGE_NAME": "\"expat\"",
        "PACKAGE_STRING": "\"expat 2.6.2\"",
        "PACKAGE_TARNAME": "\"expat\"",
        "PACKAGE_VERSION": "\"2.6.2\"",
        "VERSION": "\"2.6.2\"",
        "XML_DEV_URANDOM": "1",
        "XML_DTD": "1",
        "XML_GE": "1",
        "XML_NS": "1",
    },
)

assert_config_header_test(
    name = "expat_config_h_test",
    header = ":expat_config_h",
    must_contain = [
        "#define PACKAGE \"expat\"",
        "#define PACKAGE_BUGREPORT \"https://github.com/libexpat/libexpat/issues\"",
        "#define PACKAGE_NAME \"expat\"",
        "#define PACKAGE_STRING \"expat 2.6.2\"",
        "#define PACKAGE_TARNAME \"expat\"",
        "#define PACKAGE_VERSION \"2.6.2\"",
        "#define VERSION \"2.6.2\"",
        "#define XML_DEV_URANDOM 1",
        "#define XML_DTD 1",
        "#define XML_GE 1",
        "#define XML_NS 1",
        "\"expat\"",
        "\"https://github.com/libexpat/libexpat/issues\"",
        "\"expat\"",
        "\"expat 2.6.2\"",
        "\"expat\"",
        "\"2.6.2\"",
        "\"2.6.2\"",
    ],
    must_not_contain = [
        "/* #undef PACKAGE */",
        "/* #undef PACKAGE_BUGREPORT */",
        "/* #undef PACKAGE_NAME */",
        "/* #undef PACKAGE_STRING */",
        "/* #undef PACKAGE_TARNAME */",
        "/* #undef PACKAGE_VERSION */",
        "/* #undef VERSION */",
        "/* #undef XML_DEV_URANDOM */",
        "/* #undef XML_DTD */",
        "/* #undef XML_GE */",
        "/* #undef XML_NS */",
        "@PACKAGE@",
        "@PACKAGE_BUGREPORT@",
        "@PACKAGE_NAME@",
        "@PACKAGE_STRING@",
        "@PACKAGE_TARNAME@",
        "@PACKAGE_VERSION@",
        "@VERSION@",
        "@XML_DEV_URANDOM@",
        "@XML_DTD@",
        "@XML_GE@",
        "@XML_NS@",
        "@XML_ATTR_INFO@",
        "@XML_CONTEXT_BYTES@",
    ],
)

