bool_flag(
    name = "enable_rdrand",
    build_setting_default = False,
)

config_setting(
    name = "enable_rdrand_on",
    flag_values = {":enable_rdrand": "True"},
)

bool_flag(
    name = "override_get_random_seed",
    build_setting_default = False,
)

config_setting(
    name = "override_get_random_seed_on",
    flag_values = {":override_get_random_seed": "True"},
)

bool_flag(
    name = "enable_threading",
    build_setting_default = False,
)

config_setting(
    name = "enable_threading_on",
    flag_values = {":enable_threading": "True"},
)

bool_flag(
    name = "newlocale_needs_freelocale",
    build_setting_default = False,
)

config_setting(
    name = "newlocale_needs_freelocale_on",
    flag_values = {":newlocale_needs_freelocale": "True"},
)

# json-c's prefixed copies of two header checks (CMakeLists.txt:178-183).
check_include_file(
    name = "json_c_have_inttypes_h",
    define = "JSON_C_HAVE_INTTYPES_H",
    header = "inttypes.h",
)

check_include_file(
    name = "json_c_have_stdint_h",
    define = "JSON_C_HAVE_STDINT_H",
    header = "stdint.h",
)

config_header(
    name = "config_h",
    output = "config.h",
    template = "cmake/config.h.in",
    probes = [
        "@cc_config//catalog:have_dlfcn_h",
        "@cc_config//catalog:have_endian_h",
        "@cc_config//catalog:have_fcntl_h",
        "@cc_config//catalog:have_inttypes_h",
        "@cc_config//catalog:have_limits_h",
        "@cc_config//catalog:have_locale_h",
        "@cc_config//catalog:have_memory_h",
        "@cc_config//catalog:have_stdarg_h",
        "@cc_config//catalog:have_stdint_h",
        "@cc_config//catalog:have_stdlib_h",
        "@cc_config//catalog:have_strings_h",
        "@cc_config//catalog:have_string_h",
        "@cc_config//catalog:have_syslog_h",
        "@cc_config//catalog:have_sys_cdefs_h",
        "@cc_config//catalog:have_sys_param_h",
        "@cc_config//catalog:have_sys_random_h",
        "@cc_config//catalog:have_sys_resource_h",
        "@cc_config//catalog:have_sys_stat_h",
        "@cc_config//catalog:have_sys_types_h",
        "@cc_config//catalog:have_unistd_h",
        "@cc_config//catalog:have_xlocale_h",
        "@cc_config//catalog:have_bsd_stdlib_h",
        "@cc_config//catalog:have_arc4random",
        "@cc_config//catalog:have_open",
        "@cc_config//catalog:have_realloc",
        "@cc_config//catalog:have_setlocale",
        "@cc_config//catalog:have_snprintf",
        "@cc_config//catalog:have_strcasecmp",
        "@cc_config//catalog:have_strdup",
        "@cc_config//catalog:have_strerror",
        "@cc_config//catalog:have_strncasecmp",
        "@cc_config//catalog:have_uselocale",
        "@cc_config//catalog:have_duplocale",
        "@cc_config//catalog:have_vasprintf",
        "@cc_config//catalog:have_vprintf",
        "@cc_config//catalog:have_vsnprintf",
        "@cc_config//catalog:have_vsyslog",
        "@cc_config//catalog:have_getrandom",
        "@cc_config//catalog:have_getrusage",
        "@cc_config//catalog:have_strtoll",
        "@cc_config//catalog:have_strtoull",
        "@cc_config//catalog:sizeof_int",
        "@cc_config//catalog:sizeof_int64_t",
        "@cc_config//catalog:sizeof_long",
        "@cc_config//catalog:sizeof_long_long",
        "@cc_config//catalog:sizeof_size_t",
        "@cc_config//catalog:sizeof_ssize_t",
        "@cc_config//catalog:stdc_headers",
        ":json_c_have_inttypes_h",
    ],
    values = {
        # HAVE___THREAD is set, so CMakeLists.txt:327 picks __thread.
        "SPEC___THREAD": "__thread",
        # Fallbacks for a non-ANSI compiler; "" is undefined on a CMake template.
        "const": "",
        "size_t": "",
        # Set unconditionally (CMakeLists.txt:276), replaced only without strtoll.
        "json_c_strtoll": "strtoll",
        "json_c_strtoull": "strtoull",
        # project(json-c VERSION 0.19): no patch component, so it is empty.
        "PROJECT_NAME": "json-c",
        "JSON_C_BUGREPORT": "json-c@googlegroups.com",
        "CPACK_PACKAGE_VERSION_MAJOR": "0",
        "CPACK_PACKAGE_VERSION_MINOR": "19",
        "CPACK_PACKAGE_VERSION_PATCH": "",
    } | select({
        ":enable_rdrand_on": {"ENABLE_RDRAND": "OFF"},
        "//conditions:default": {},
    }) | select({
        ":override_get_random_seed_on": {"OVERRIDE_GET_RANDOM_SEED": "OFF"},
        "//conditions:default": {},
    }) | select({
        ":enable_threading_on": {"ENABLE_THREADING": "OFF"},
        "//conditions:default": {},
    }) | select({
        ":newlocale_needs_freelocale_on": {"NEWLOCALE_NEEDS_FREELOCALE": "OFF"},
        "//conditions:default": {},
    }) | {
        "HAS_GNU_WARNING_LONG": "",
        "HAVE_DOPRNT": "",
        "HAVE_ATOMIC_BUILTINS": "1",
        "HAVE_DECL_INFINITY": "1",
        "HAVE_DECL_ISINF": "1",
        "HAVE_DECL_ISNAN": "1",
        "HAVE_DECL_NAN": "1",
        "HAVE_DECL__FINITE": "",
        "HAVE_DECL__ISNAN": "",
        "HAVE___THREAD": "1",
    },
)

assert_config_header_test(
    name = "config_h_test",
    header = ":config_h",
    must_not_contain = [
        "#cmakedefine",
        "@HAS_GNU_WARNING_LONG@",
        "@HAVE_DOPRNT@",
        "@HAVE_ATOMIC_BUILTINS@",
        "@HAVE_DECL_INFINITY@",
        "@HAVE_DECL_ISINF@",
        "@HAVE_DECL_ISNAN@",
        "@HAVE_DECL_NAN@",
        "@HAVE_DECL__FINITE@",
        "@HAVE_DECL__ISNAN@",
        "@HAVE___THREAD@",
        "@ENABLE_RDRAND@",
        "@OVERRIDE_GET_RANDOM_SEED@",
        "@ENABLE_THREADING@",
        "@NEWLOCALE_NEEDS_FREELOCALE@",
    ],
)

config_header(
    name = "json_config_h",
    output = "json_config.h",
    template = "cmake/json_config.h.in",
    probes = [
        ":json_c_have_inttypes_h",
        ":json_c_have_stdint_h",
    ],
)

assert_config_header_test(
    name = "json_config_h_test",
    header = ":json_config_h",
    must_not_contain = [
        "#cmakedefine",
    ],
)

# CMake's `distcheck` UTILITY target (needs_attention 001) is deliberately
# not reproduced: it checks the source-package round trip through CMake,
# not anything the build produces.
config_header(
    name = "json_h",
    output = "json.h",
    template = "json.h.cmakein",
    values = {
        "JSON_H_JSON_PATCH": "#include \"json_patch.h\"",
        "JSON_H_JSON_POINTER": "#include \"json_pointer.h\"",
    },
)

assert_config_header_test(
    name = "json_h_test",
    header = ":json_h",
)

config_header(
    name = "apps_config_h",
    output = "apps_config.h",
    template = "apps/cmake/apps_config.h.in",
    probes = [
        "@cc_config//catalog:have_sys_resource_h",
        "@cc_config//catalog:have_getrusage",
    ],
    values = {
        "HAVE_JSON_TOKENER_GET_PARSE_END": "",  # project_notes/001: set() with no value unsets it
    },
)

assert_config_header_test(
    name = "apps_config_h_test",
    header = ":apps_config_h",
    must_not_contain = [
        "#cmakedefine",
