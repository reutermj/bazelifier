# The project also ships a checked-in `zconf.h`. It is deliberately NOT in
# this module: the build reads the GENERATED one, and a source file at the
# same path wins the include search and would hide it, an unresolved
# macro's #error included. Resolve values on this rule; do not restore
# that file.
config_header(
    name = "zconf_h",
    output = "zconf.h",
    template = "zconf.h.cmakein",
    probes = [
        "@cc_config//catalog:have_stdarg_h",
        "@cc_config//catalog:have_unistd_h",
    ],
    values = {
        "Z_PREFIX": "",  # option(ZLIB_PREFIX ... OFF), the default the ground truth used
    },
)

assert_config_header_test(
    name = "zconf_h_test",
    header = ":zconf_h",
    must_not_contain = [
        "#cmakedefine",
    ],
)

cc_binary(
    name = "infcover",
    srcs = [
        "test/infcover.c",
        "inflate.h",
        "inftrees.h",
        "zlib.h",
        ":zconf_h",
    ],
    local_defines = [
        "_LARGEFILE64_SOURCE=1",
    ],
    deps = [
        ":zlibstatic",
    ],
    visibility = ["//visibility:public"],
)

