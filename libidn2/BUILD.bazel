# The project also ships a checked-in `lib/idn2.h`. It is deliberately NOT in
# this module: the build reads the GENERATED one, and a source file at the
# same path wins the include search and would hide it, an unresolved
# macro's #error included. Resolve values on this rule; do not restore
# that file.
config_header(
    name = "lib_idn2_h",
    output = "lib/idn2.h",
    template = "lib/idn2.h.in",
    values = {
        "MAJOR_VERSION": "2",
        "MINOR_VERSION": "3",
        "NUMBER_VERSION": "0x02030007",
        "PATCH_VERSION": "7",
        "VERSION": "2.3.7",
    },
)

