load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# hwloc 2.7.1, the second leaf of the Open MPI chain (bzl-7r9.4), pinned in
# MODULE.bazel as @hwloc.
#
# Converted as hwloc ships: its own default configuration is the ground
# truth (see overview.md, "Convert the project, not the consumer's use of
# it"). Open MPI's --enable-plugins is Open MPI's business; what this host
# contributes to a default configure (libxml2, so the xml_libxml plugin
# builds; ncursesw for lstopo) surfaces as unconverted_dependency items and
# is decided in the module. *(History: the first pin, 2026-09-19, carried
# --enable-plugins plus a --disable-X per optional library, and a guessed
# --disable-pci silently turned off sysfs PCI discovery — project note 001.)*
#
# END STATE (2026-09-19, converted as hwloc ships): GREEN from the unpacked
# workspace after the agent stage — 17/17 comparisons, 180/180 module tests
# (45 compiled check programs, 122 recorded-topology tests, 11
# configure-generated scripts, 2 config-header assertions), no open items;
# post-agent row in metrics/history_post_agent.jsonl. What it cost:
#
# - Translator gaps found and fixed: 6 — make -p read as one flat database
#   (per-directory scopes, on an Entering/Leaving stack); undefined
#   $(am__*) conditionals; a target's sources read from the wrong
#   directory; RUNSTATEDIR's quotes eaten by local_defines; an assertion
#   forbidding #undef of a probe that answered 0; the Entering-only scope
#   bug that attributed 67 tests to the wrong directory.
# - Escalations at first conversion: 8 items, 179 unmapped names; at green
#   under the default configure: 6 items, 62 names.
# - Agent-stage decisions: libhwloc without the host's libxml2 (the -lxml2
#   item; the built-in XML backend serves every XML test); lstopo without a
#   terminal library (-lncursesw); 16 probe aliases for facts configure
#   derives under its own names; ~80 values, grouped by why in the module;
#   a genrule for the configure-written static-components.h; two runners
#   reproducing the topology tests and the .sh.in scripts under automake's
#   layout; tests/hwloc's check programs run through wrapper.sh (note 002).
# - Reversed twice: the first pin's flags (above, note 001), caught by
#   upstream's own `make check`; then consumer flags on a pin at all.
convert_autotools_project(
    name = "converted",
    srcs = ["@hwloc//:all_srcs"],
    visibility = [
        "//translator/tests:__pkg__",
        "//translator/tests/corpus:__subpackages__",
    ],
)
