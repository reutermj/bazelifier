load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# First Autotools corpus project. xz brings target shapes no CMake project in
# the corpus has: a versioned libtool shared library (liblzma.la), several
# programs from one Makefile.am, and 13 check_PROGRAMS forming a real test
# suite.
#
# Sources come from the @xz http_archive (pinned in MODULE.bazel) as a release
# TARBALL, which ships `configure` pre-generated — a git checkout would need
# `autoreconf -i` and make the conversion depend on the host's autotools.
# source_dir is left empty so the rule derives it from where configure.ac
# landed.
#
# The conversion itself succeeds; the module does not yet BUILD, and the
# reason is an open needs_attention item rather than a translator defect.
# config.h.in names ~150 macros with no probe in the shared catalog, so the
# generated config.h leaves HAVE_STDBOOL_H and HAVE__BOOL undefined and xz
# falls into a fallback that redeclares `_Bool`. That is the agent stage's
# work — see docs/architecture/needs-attention-interface.md.
#
# Not enrolled in //translator/tests:validation_workspace for a separate
# reason: xz's programs link liblzma.la, so `make` leaves a libtool WRAPPER
# SCRIPT where each binary should be and ground-truth capture copies the
# script (bzl-yjn.4).
#
# See bzl-yjn.
convert_autotools_project(
    name = "converted",
    srcs = ["@xz//:all_srcs"],
    visibility = ["//translator/tests:__pkg__"],
)
