load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# OpenPMIx 5.0.11, the third node of the Open MPI chain (bzl-7r9.5), pinned
# in MODULE.bazel as @pmix.
#
# Converted as PMIx ships: its own default configuration is the ground
# truth (overview.md, "Convert the project, not the consumer's use of it").
# The two converted leaves it links are supplied as `deps`, so its configure
# finds them through the relocated sysroot exactly as a consumer's would
# (build-verification.md, "Depending on another converted module"), and
# every link input that resolves into that sysroot becomes a cross-module
# edge rather than an escalation. What this host contributes beyond that
# (zlib for the pcompress component, munge, ...) surfaces as
# unconverted_dependency items and is decided in the module.
#
# STATE (2026-09-19, stopping point — RED, with a diagnosis): converts to 95
# targets, 1 expressible test, 6 items; eight translator gaps it surfaced
# are fixed and pinned (see bzl-7r9.5's notes for the list). The agent-stage
# resolution is kept as tools/resolutions/pmix/ (applied together with the
# adapted hwloc and libevent resolutions it depends on). Applied, every
# source compiles and all four config-header assertions pass; libpmix.so
# does not yet LINK: the frontend keys compiled objects by the path the
# compiler printed, so the six bfrops components' same-named copy.c collide
# and one archive carries another's file — duplicate symbols. Filed as the
# last known blocker; fix it, re-apply, then measure.
convert_autotools_project(
    name = "converted",
    srcs = ["@pmix//:all_srcs"],
    visibility = [
        "//translator/tests:__pkg__",
        "//translator/tests/corpus:__subpackages__",
    ],
    deps = [
        "//translator/tests/corpus/hwloc:converted",
        "//translator/tests/corpus/libevent:converted",
    ],
)
