load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# The first real upstream project driving the translator (corpus tier),
# distinct from the synthetic single-capability fixtures under
# translator/tests/fixtures/. tinyxml2 is one library (tinyxml2) plus one
# test executable (xmltest); it exercises target_compile_definitions
# (handled as of bzl-c54.1), an ALIAS target on the link edge, and CTest
# with runtime data — the last of which is expected to surface as
# needs_attention items this ingestion is meant to discover. See bzl-c54.4.
#
# Sources come from the @tinyxml2 git_repository (pinned in MODULE.bazel),
# not vendored into this repo: the pinned commit is the version record, and
# the translator copies the referenced sources into the standalone module
# it emits, so the deliverable stays self-contained. source_dir is left
# empty so the rule derives the staged external path from the CMakeLists.txt.
#
# The conversion is CLEAN — zero needs_attention items: the CTest dashboard
# UTILITY targets are dropped by provenance (bzl-c54.6), and tinyxml2.h is
# classified public via its install(FILES ... TYPE INCLUDE) rule (bzl-c54.7),
# so it lands in hdrs. The library builds hermetically, and xmltest is
# validated by its own generated Bazel test (@tinyxml2//:xmltest_test),
# which runs it at its declared WORKING_DIRECTORY with resources/ staged and
# asserts CMake's own PASS_REGULAR_EXPRESSION ", Fail 0" (bzl-c54.8). The
# validation_workspace runs that test instead of a naive ground-truth stdout
# comparison, which for a data-driven test would false-pass. Fully enrolled
# and green.
convert_cmake_project(
    name = "converted",
    srcs = ["@tinyxml2//:all_srcs"],
    visibility = ["//translator/tests:__pkg__"],
)
