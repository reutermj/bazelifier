load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# Second Autotools corpus project, after xz. Selection rationale and the five
# rejected candidates are in the `expat` http_archive comment in MODULE.bazel;
# the short version is that it is the only one of six with no gnulib
# replacement headers and a real Makefile.am.
#
# What it exercises that xz does not: recursive make across five SUBDIRS
# (lib, examples, tests, xmlwf, doc), one libtool shared library consumed by a
# program in a SIBLING directory, and a C++ check program beside the C ones.
#
# Sources come from the @expat http_archive (pinned in MODULE.bazel) as a
# release TARBALL, which ships `configure` pre-generated — a git checkout
# would need `autoreconf -i` and make the conversion depend on the host's
# autotools. source_dir is left empty so the rule derives it from where
# configure.ac landed.
#
# The conversion succeeds (7 targets, 1 escalation). Onboarding it surfaced
# two translator bugs, both since fixed:
#
#  - lib/xmltok.c textually `#include`s xmltok_impl.c and xmltok_ns.c, which
#    reached neither `textual_hdrs` nor the module. Fixed by
#    headers::textually_included_sources — a SHARED scan, because the CMake
#    frontend faces the same question from better evidence (`ninja -t deps`)
#    and neither frontend may import the other. Pinned by fixture
#    autotools/005, which goes red at compile if it regresses (bzl-7pe.3).
#  - `textual_sources` was declared but never COPIED, failing at analysis
#    rather than at compile. Latent on the CMake side too.
#
# Green post-agent: 5/5 ground-truth comparisons and the config-header
# assertion pass. The one escalation was a legitimate handoff rather than a
# defect — XML_GE, XML_DTD, XML_CONTEXT_BYTES and friends are project feature
# switches whose values come from expat's OWN defaults in configure.ac, not
# from probing this host. Resolutions are ephemeral (bzl-b9b), so re-running
# the agent stage is expected after any translator change.
convert_autotools_project(
    name = "converted",
    srcs = ["@expat//:all_srcs"],
    visibility = ["//translator/tests:__pkg__"],
)
