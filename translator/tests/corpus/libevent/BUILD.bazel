load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# libevent 2.1.12-stable, the leaf of the Open MPI chain (bzl-7r9.3), pinned
# in MODULE.bazel as @libevent.
#
# Converted as libevent ships: its own default configuration is the ground
# truth (see overview.md, "Convert the project, not the consumer's use of
# it"). What Open MPI passes its bundled copy (--disable-openssl and
# friends) is Open MPI's business, expressed through this module's options
# from Open MPI's side; what THIS host contributes to a default configure
# (OpenSSL headers, so libevent_openssl builds and links -lssl) surfaces as
# an unconverted_dependency item and is decided in the module.
#
# END STATE (2026-09-19, converted as libevent ships): GREEN from the
# unpacked workspace after the agent stage — 20/20 comparisons, 12/12 module
# tests (2 config-header assertions, the 10 test_runner_* suites), 3
# comparisons omitted by recorded decision (the two OpenSSL samples; regress,
# whose ground truth ran OpenSSL and zlib tests that no converted module can
# supply). Post-agent row in metrics/history_post_agent.jsonl. Cost, for the
# onboarding record:
#
# - Translator gaps found: 6. Fixed: 4 — primaries declared through
#   variables converted to zero targets; a make-time sed-generated header
#   silently absent (generated_headers escalation); automake install dirs
#   for public headers; a program declared under two primaries rendered
#   twice. Filed: a source under a probe-decided conditional dropped
#   (bzl-42r, strlcpy.c); a valued macro under a boolean flag frozen as 1
#   (bzl-iwo, SIZEOF_PTHREAD_T).
# - Escalations at first conversion: 4 items, 116 unmapped names. At green
#   under the default configure: 7 items, 41 names, after 75 catalog facts.
# - Agent-stage decisions: enable_openssl defaults off and the OpenSSL
#   targets are omitted (no converted OpenSSL); regress built without
#   regress_zlib.c (zlib is converted, but the CMake frontend has no install
#   step yet — bzl-7r9.8); 4 probe aliases; a genrule for event-config.h;
#   strlcpy.c carried (note 001); the ten runners reproduced through the
#   autotools layout (note 002).
# - Reference expansion moved libidn2 (+14 tests), libmicrohttpd (+12),
#   xz (+2) with no comparison changing state.
convert_autotools_project(
    name = "converted",
    srcs = ["@libevent//:all_srcs"],
    visibility = [
        "//translator/tests:__pkg__",
        "//translator/tests/corpus:__subpackages__",
    ],
)
