load("//translator/build_defs:validation_workspace.bzl", "validation_workspace")

# This list is what enrols a fixture in validation: a fixture directory
# that builds fine on its own but is missing here is simply never tested,
# and nothing reports that. See docs/architecture/build-verification.md.
validation_workspace(
    name = "validation_workspace",
    fixtures = [
        "//translator/tests/fixtures/001-hello-world:converted",
        "//translator/tests/fixtures/002-with-library:converted",
        "//translator/tests/fixtures/003-library-no-file-set:converted",
        "//translator/tests/fixtures/004-binary-private-include:converted",
        "//translator/tests/fixtures/005-unsupported-target-type:converted",
        "//translator/tests/fixtures/006-sibling-sources:converted",
    ],
)
