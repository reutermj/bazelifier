load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# A library with plain, non-FILE_SET headers and a consumer: the translator
# can't tell which headers are public, so it escalates instead of guessing.
#
# The CMakeLists.txt here intentionally omits a public FILE_SET forever —
# that's the input shape under test. Never "fix" it to make conversion
# succeed; the agent stage resolves it by populating hdrs in the GENERATED
# BUILD.bazel.
#
# Full rationale: docs/architecture/build-verification.md#fixtures.
convert_cmake_project(
    name = "converted",
    srcs = ["CMakeLists.txt"] + glob(["src/**"]),
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
)
