load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# Drives the include-path header injection (bzl-fxa.18): app.c #includes
# helpers/util.h, which CMake never lists as a source because the include
# path alone is enough for it. Bazel stages only declared inputs, so the
# header has to become one. helpers/unused.h pins the other direction — on
# the same include path, included by nobody, and must stay out of the module.
# See the fixture's CMakeLists.txt.
convert_cmake_project(
    name = "converted",
    srcs = ["CMakeLists.txt"] + glob([
        "src/**",
        "helpers/**",
    ]),
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
)
