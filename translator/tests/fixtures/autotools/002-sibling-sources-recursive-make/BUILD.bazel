load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# Drives recursive-make path resolution (bzl-yjn.7): `tool` is built from
# app/main.c AND ../common/util.c across a subdirectory boundary, so every path
# in the command stream is relative to app/ rather than to the build root.
#
# See the fixture's configure.ac for why the sibling compile is the case under
# test and must not be "simplified" away.
convert_autotools_project(
    name = "converted",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
)
