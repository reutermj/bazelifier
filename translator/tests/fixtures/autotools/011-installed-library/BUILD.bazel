    source_dir = package_name(),
    visibility = [
        "//translator/tests:__pkg__",
        "//translator/tests/fixtures/autotools/012-links-installed-library:__pkg__",
        "//translator/tests/fixtures/autotools/013-shared-library-links-installed-library:__pkg__",
    ],
