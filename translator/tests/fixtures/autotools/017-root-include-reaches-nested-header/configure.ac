# A source including a header in ANOTHER directory by its path from the
# project root, found through -iquote$(top_srcdir) — PRRTE's (and PMIx's)
# convention. No _SOURCES lists the header; only the include path reaches it.
AC_INIT([rootinc], [1.0])
AM_INIT_AUTOMAKE([foreign subdir-objects])
AC_PROG_CC
AC_CONFIG_FILES([Makefile])
AC_OUTPUT
