# A program installed under a second name by an install hook, dispatching
# on argv[0] — xz's unxz/xzcat, hwloc's lstopo, PRRTE's prterun. No compile
# or link command produces the second name; only `make install` does.
AC_INIT([twonames], [1.0])
AM_INIT_AUTOMAKE([foreign])
AC_PROG_CC
AC_PROG_LN_S
AC_CONFIG_FILES([Makefile])
AC_OUTPUT
