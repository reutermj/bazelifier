load("//translator/build_defs:convert_cmake_project.bzl", "convert_autotools_project")

# The shared-library consumer of the cross-module pair (see configure.ac):
# with 011 as a dependency its libusegreet must become a cc_shared_library
# whose dynamic_deps names @greet's wrapper, and app must run against both.
convert_autotools_project(
    name = "converted",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
    deps = ["//translator/tests/fixtures/autotools/011-installed-library:converted"],
)
