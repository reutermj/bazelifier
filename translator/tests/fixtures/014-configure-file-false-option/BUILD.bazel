load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# Drives the CMake-false-token config-header case (bzl-fxa.8): an option left
# OFF reaches a #cmakedefine via the cache and must undef, not #define the
# literal token. Both options resolve from the cache, so this converts fully
# green. See the fixture's CMakeLists.txt.
convert_cmake_project(
    name = "converted",
    srcs = ["CMakeLists.txt"] + glob([
        "src/**",
        "*.in",
    ]),
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
)
