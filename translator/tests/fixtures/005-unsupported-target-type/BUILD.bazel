load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# A UTILITY target (from add_custom_target) the translator cannot emit at
# all — where 003 escalates an attribute it couldn't populate, this
# escalates a whole missing target, and asserts the rest of the project
# still converts.
#
# `app` builds and matches ground truth even with the item open, so the
# needs_attention/ gate is the ONLY thing keeping this red — that's the
# property under test: escalation must not depend on the conversion also
# happening to break.
#
# Full rationale: docs/architecture/build-verification.md#fixtures.
convert_cmake_project(
    name = "converted",
    srcs = ["CMakeLists.txt"] + glob(["src/**"]),
    expected_targets = ["app"],
    module_name = "unsupported_target_type",
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
)
