load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# Drives SHARED_LIBRARY handling (bzl-i4i.1): one library built both shared
# and static over the same sources, with a consumer linking each. See the
# fixture's CMakeLists.txt.
convert_cmake_project(
    name = "converted",
    srcs = ["CMakeLists.txt"] + glob([
        "lib/**",
        "app/**",
    ]),
    source_dir = package_name(),
    visibility = ["//translator/tests:__pkg__"],
)
