load("//translator/build_defs:convert_cmake_project.bzl", "convert_cmake_project")

# Exercises a module root wider than the CMake project directory: the CMake
# project is `proj/`, but it compiles sources from the sibling `shared/`, so
# `deliverable_root` is the whole fixture directory and the module roots
# there rather than at `proj/`. Nothing is escalated — the files ship with
# the project.
#
# The fixture is still one self-contained directory, keeping the
# one-directory-per-fixture convention while still placing a source outside
# the CMake project's own root.
#
# Full rationale: docs/architecture/build-verification.md#fixtures.
convert_cmake_project(
    name = "converted",
    srcs = glob([
        "proj/**",
        "shared/**",
    ]),
    deliverable_root = package_name(),
    expected_targets = ["app"],
    module_name = "sibling_sources",
    source_dir = package_name() + "/proj",
    visibility = ["//translator/tests:__pkg__"],
)
