load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

rust_binary(
    name = "bazelifier",
    srcs = [
        "src/autotools.rs",
        "src/cmake_api.rs",
        "src/codegen.rs",
        "src/configure_file.rs",
        "src/ctest.rs",
        "src/error.rs",
        "src/headers.rs",
        "src/main.rs",
        "src/model.rs",
        "src/needs_attention.rs",
        "src/ninja_deps.rs",
        "src/paths.rs",
        "src/resolutions.rs",
    ],
    edition = "2024",
    visibility = ["//translator/build_defs:__pkg__"],
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "bazelifier_test",
    crate = ":bazelifier",
    edition = "2024",
)

# The configure_file module, as data for the catalog drift check — it holds
# the CATALOG_DEFINES copy being compared against the Starlark catalog. See
# //:catalog_sync_check.
exports_files(["src/configure_file.rs"])
